{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {
        "disabled": false,
        "level": "warning",
        "timestamp": true,
        "output": "sing-box-log.log"
    },
    "dns": {
        "servers": [
            {
                "type": "local",
                "tag": "local-dns",
                "prefer_go": false,
                "detour": "direct"
            },
            {
                "type": "udp",
                "tag": "CN-dns-backup",
                "server": "223.5.5.5",
                "server_port": 53,
                "detour": "direct"
            },
            {
                "type": "fakeip",
                "tag": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            },
            {
                "type": "https",
                "tag": "remote-dns",
                "server": "1.1.1.1",
                "server_port": 443,
                "path": "/dns-query",
                "detour": "主代理"
            },
            {
                "type": "https",
                "tag": "remote-dns-backup",
                "server": "8.8.8.8",
                "path": "/dns-query",
                "detour": "主代理"
            },
            {
                "type": "https",
                "tag": "final-dns",
                "server": "223.5.5.5",
                "path": "/dns-query",
                "detour": "direct"
            }
        ],
        "rules": [
            
            {
                "rule_set": [
                    "GeoSite-CN"
                ],
                "action": "route",
                "server": "local-dns"
            },
            {
                "rule_set": [
                    "GeoSite-CN"
                ],
                "action": "route",
                "server": "CN-dns-backup"
            },
            {
                "rule_set": [
                    "GeoLocation-!CN"
                ],
                "action": "route",
                "server": "remote-dns"
            },
            {
                "rule_set": [
                    "GeoLocation-!CN"
                ],
                "action": "route",
                "server": "remote-dns-backup"
            },
            {
                "query_type": [
                    "A",
                    "AAAA"
                ],
                "action": "route",
                "server": "fakeip",
                "disable_cache": false
            }
        ],
        "final": "final-dns",
        "strategy": "prefer_ipv4",
        "disable_cache": false,
        "disable_expire": false,
        "cache_capacity": 4096,
        "reverse_mapping": false
    },
    "ntp": {
        "enabled": true,
        "server": "time.apple.com",
        "server_port": 123,
        "interval": "2h",
        "detour": "direct"
    },
    "http_clients": [
        {
            "tag": "default",
            "detour": "direct"
        }
    ],
    "inbounds": [
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "127.0.0.1",
            "listen_port": 41180,
            "tcp_fast_open": true,
            "tcp_multi_path": true,
            "udp_fragment": false
        },
        {
            "type": "tun",
            "tag": "tun-in",
            "interface_name": "tun",
            "address": [
                "198.18.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "mtu": 0,
            "auto_route": true,
            "strict_route": true,
            "route_exclude_address": [
                "0.0.0.0/8",
                "10.0.0.0/8",
                "100.64.0.0/10",
                "192.168.0.0/16",
                "172.16.0.0/12"
            ],
            "stack": "mixed"
        },
        {
            "type": "socks",
            "tag": "socks-in",
            "listen": "127.0.0.1",
            "listen_port": 41170,
            "tcp_fast_open": true,
            "tcp_multi_path": true,
            "udp_fragment": false
        }
    ],
    "outbounds": [
        {
            "type": "selector",
            "tag": "主代理",
            "interrupt_exist_connections": true,
            "outbounds": [
                "JP自动-mitce",
                "SG自动-mitce",
                "HK自动-mitce",
                "US自动-mitce",
                "TW自动-mitce",
                "KR自动-mitce",
                "直连",
                "SNTP自选"
            ]
        },
        {
            "type": "selector",
            "tag": "SNTP自选",
            "interrupt_exist_connections": true,
            "outbounds": []
        },
        {
            "type": "selector",
            "tag": "openai",
            "interrupt_exist_connections": true,
            "outbounds": [
                "主代理",
                "US自动-mitce",
                "HK自动-mitce",
                "KR自动-mitce",
                "SG自动-mitce",
                "JP自动-mitce",
                "TW自动-mitce"
            ]
        },
        {
            "type": "selector",
            "tag": "google",
            "interrupt_exist_connections": true,
            "outbounds": [
                "主代理",
                "直连",
                "SNTP自选",
                "JP自动-mitce",
                "TW自动-mitce",
                "HK自动-mitce",
                "KR自动-mitce",
                "SG自动-mitce",
                "US自动-mitce"
            ]
        },
        {
            "type": "selector",
            "tag": "youtube",
            "interrupt_exist_connections": true,
            "outbounds": [
                "直连",
                "KR自动-mitce",
                "HK自动-mitce",
                "TW自动-mitce",
                "US自动-mitce",
                "SG自动-mitce",
                "JP自动-mitce",
                "SNTP自选",
                "主代理",
                "google"
            ]
        },
        {
            "type": "selector",
            "tag": "bilibili",
            "interrupt_exist_connections": true,
            "outbounds": [
                "直连",
                "KR自动-mitce",
                "SG自动-mitce",
                "US自动-mitce",
                "HK自动-mitce",
                "JP自动-mitce",
                "TW自动-mitce",
                "SNTP自选",
                "主代理"
            ]
        },
        {
            "type": "selector",
            "tag": "microsoft",
            "interrupt_exist_connections": true,
            "outbounds": [
                "主代理",
                "SNTP自选",
                "GLOBAL",
                "JP自动-mitce",
                "TW自动-mitce",
                "HK自动-mitce",
                "US自动-mitce",
                "SG自动-mitce",
                "KR自动-mitce",
                "直连"
            ]
        },
        {
            "type": "selector",
            "tag": "telegram",
            "interrupt_exist_connections": true,
            "outbounds": [
                "直连",
                "KR自动-mitce",
                "HK自动-mitce",
                "TW自动-mitce",
                "JP自动-mitce",
                "SG自动-mitce",
                "US自动-mitce",
                "SNTP自选",
                "主代理"
            ]
        },
        {
            "type": "selector",
            "tag": "漏网之鱼",
            "interrupt_exist_connections": true,
            "outbounds": [
                "主代理",
                "直连"
            ]
        },
        {
            "type": "selector",
            "tag": "GLOBAL",
            "interrupt_exist_connections": true,
            "outbounds": [
                "主代理",
                "直连"
            ]
        },
        {
            "type": "urltest",
            "tag": "US自动-mitce",
            "url": "https://www.google.com",
            "interval": "1m",
            "tolerance": 80,
            "interrupt_exist_connections": true,
            "outbounds": []
        },
        {
            "type": "urltest",
            "tag": "HK自动-mitce",
            "url": "https://www.google.com",
            "interval": "1m",
            "tolerance": 80,
            "interrupt_exist_connections": true,
            "outbounds": []
        },
        {
            "type": "urltest",
            "tag": "TW自动-mitce",
            "url": "https://www.google.com",
            "interval": "1m",
            "tolerance": 80,
            "interrupt_exist_connections": true,
            "outbounds": []
        },
        {
            "type": "urltest",
            "tag": "JP自动-mitce",
            "url": "https://www.google.com",
            "interval": "1m",
            "tolerance": 80,
            "interrupt_exist_connections": true,
            "outbounds": []
        },
        {
            "type": "urltest",
            "tag": "SG自动-mitce",
            "url": "https://www.google.com",
            "interval": "1m",
            "tolerance": 80,
            "interrupt_exist_connections": true,
            "outbounds": []
        },
        {
            "type": "urltest",
            "tag": "KR自动-mitce",
            "url": "https://www.google.com",
            "interval": "1m",
            "tolerance": 80,
            "interrupt_exist_connections": true,
            "outbounds": []
        },
        {
            "type": "selector",
            "tag": "直连",
            "interrupt_exist_connections": true,
            "outbounds": [
                "direct"
            ]
        },
        {
            "type": "direct",
            "tag": "direct"
        }
    ],
    "route": {
        "rules": [
            {
                "action": "sniff",
                "inbound": "tun-in"
            },
            {
                "action": "hijack-dns",
                "protocol": "dns"
            },
            {
                "action": "route",
                "clash_mode": "direct",
                "outbound": "直连"
            },
            {
                "action": "route",
                "clash_mode": "global",
                "outbound": "GLOBAL"
            },
            {
                "action": "route",
                "domain_suffix": "123pan.cn",
                "outbound": "直连"
            },
            {
                "action": "route",
                "domain_suffix": "ecust.edu.cn",
                "outbound": "直连"
            },
            {
                "action": "route",
                "rule_set": [
                    "openai-geosite.srs"
                ],
                "outbound": "openai"
            },
            {
                "action": "route",
                "rule_set": [
                    "bilibili-geosite.srs"
                ],
                "outbound": "bilibili"
            },
            {
                "action": "route",
                "rule_set": [
                    "microsoft-geosite.srs"
                ],
                "outbound": "microsoft"
            },
            {
                "action": "route",
                "rule_set": [
                    "telegram-geosite.srs",
                    "telegram-geoip.srs"
                ],
                "outbound": "telegram"
            },
            {
                "action": "route",
                "rule_set": [
                    "youtube-geosite.srs"
                ],
                "outbound": "youtube"
            },
            {
                "action": "route",
                "rule_set": [
                    "google-geoip.srs",
                    "google-geosite.srs"
                ],
                "outbound": "google"
            },
            {
                "action": "route",
                "network": "icmp",
                "outbound": "直连"
            },
            {
                "action": "route",
                "rule_set": [
                    "GeoSite-Private"
                ],
                "outbound": "直连"
            },
            {
                "action": "route",
                "rule_set": [
                    "GeoSite-CN"
                ],
                "outbound": "直连"
            },
            {
                "action": "route",
                "rule_set": [
                    "GeoIP-Private"
                ],
                "outbound": "直连"
            },
            {
                "action": "route",
                "rule_set": [
                    "GeoIP-CN"
                ],
                "outbound": "直连"
            },
            {
                "action": "route",
                "inbound": "tun-in",
                "outbound": "漏网之鱼"
            },
            {
                "action": "route",
                "inbound": "mixed-in",
                "outbound": "漏网之鱼"
            }
        ],
        "rule_set": [
